<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiTaskFlow.UI.MainPage"
    Title="My Tasks">

    <Grid
        Padding="16"
        RowDefinitions="60,60,*">

        <!-- Header -->
        <Grid Grid.Row="0">

            <Label
                Text="My Tasks"
                FontSize="28"
                FontAttributes="Bold"
                VerticalOptions="Center" />

        </Grid>


        <!-- Search Box -->
        <Border
            Grid.Row="1"
            Padding="12,0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12">

            <Entry
                Placeholder="Search tasks..."
                ClearButtonVisibility="WhileEditing"
                VerticalOptions="Center" />

        </Border>


        <!-- Task List -->
        <CollectionView
            Grid.Row="2"
            Margin="0,16,0,0"
            ItemsSource="{Binding Tasks}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <!-- Space Between Cards -->
                    <VerticalStackLayout Padding="0,0,0,16">

                        <!-- Task Card -->
                        <Border
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">

                            <Border.Shadow>
                                <Shadow
                                    Offset="0,3"
                                    Radius="8"
                                    Opacity="0.18" />
                            </Border.Shadow>


                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="Auto,*,Auto"
                                RowSpacing="6">

                                <!-- Checkbox -->
                                <CheckBox
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="0"
                                    IsChecked="{Binding IsCompleted}"
                                    VerticalOptions="Center" />


                                <!-- Title -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Title}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />


                                <!-- Menu -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Text="⋮"
                                    FontSize="24"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center" />


                                <!-- Metadata -->
                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="6">

                                    <Label
                                        Text="{Binding DueDate}"
                                        FontSize="12"
                                        Opacity="0.7" />

                                    <Label
                                        Text="•"
                                        FontSize="12"
                                        Opacity="0.5" />

                                    <Label
                                        Text="{Binding DueTime}"
                                        FontSize="12"
                                        Opacity="0.7" />

                                    <Label
                                        Text="•"
                                        FontSize="12"
                                        Opacity="0.5" />

                                    <Label
                                        Text="{Binding Priority}"
                                        FontSize="12"
                                        Opacity="0.7" />

                                </HorizontalStackLayout>


                                <!-- Description -->
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Description}"
                                    FontSize="13"
                                    Opacity="0.65"
                                    LineBreakMode="TailTruncation" />

                            </Grid>

                        </Border>

                    </VerticalStackLayout>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- Floating Add Button -->
        <Button
            Grid.Row="2"
            Text="+"
            FontSize="28"
            WidthRequest="60"
            HeightRequest="60"
            CornerRadius="30"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,8,8" />

    </Grid>

</ContentPage>